{
    "productName": "Soda POS",
    "appId": "com.soda.pos",
    "directories": {
        "output": "release"
    },
    "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "package.json"
    ],
    "win": {
        "target": [
            "nsis"
        ]
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "Soda POS",
        "runAfterFinish": true
    },
    "extraResources": [
        "local.db",
        ".env"
    ]
}
