{
  "name": "pos-modern-v2",
  "private": true,
  "version": "0.9.4",
  "description": "POS System for Soda El Pelón",
  "author": "Antigravity",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "cross-env ELECTRON=true vite",
    "clean": "rimraf dist release dist-electron",
    "build": "tsc -b && vite build",
    "electron:build": "cross-env ELECTRON=true npm run clean && cross-env ELECTRON=true npm run build && electron-builder --win",
    "electron:preview": "cross-env ELECTRON=true tsc -b && cross-env ELECTRON=true vite build && electron .",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.pospelon.app",
    "productName": "POS Soda El Pelon",
    "directories": {
      "output": "release"
    },
    "compression": "normal",
    "win": {
      "icon": "src/assets/logo-pospelon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "local.db",
        "to": "local.db"
      },
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "src/assets/logo-pospelon.png",
        "to": "assets/logo-pospelon.png"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "ByJafetDG",
      "repo": "NewSodaPos",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@prisma/client": "^7.4.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.90.21",
    "better-sqlite3": "^12.6.2",
    "date-fns": "^4.1.0",
    "electron-pos-printer": "^1.3.8",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.34.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.9.2",
    "sileo": "^0.1.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "electron": "^40.4.1",
    "electron-builder": "26.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prisma": "^7.4.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
